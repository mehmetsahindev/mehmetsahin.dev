{
  "name": "mehmetsahin.dev",
  "version": "0.1.0",
  "description": "Personal website of Mehmet Şahin, based on chanhdai.com.",
  "homepage": "https://mehmetsahin.dev",
  "license": "MIT",
  "author": {
    "name": "Mehmet Şahin",
    "url": "https://github.com/mehmetsahindev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetsahindev/mehmetsahin.dev.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "check-types": "tsc --noEmit --pretty",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,md,mdx}\" --cache",
    "generate-libphonenumber-metadata": "libphonenumber-metadata-generator ./src/assets/libphonenumber.metadata.json --countries TR --extended",
    "upgrade:next": "npx @next/codemod@latest upgrade latest",
    "upgrade:tailwind": "npx @tailwindcss/upgrade@latest",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:export": "node --env-file=.env.local scripts/export-seed.mjs"
  },
