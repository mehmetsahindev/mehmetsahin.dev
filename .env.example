NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres. Local dev: `docker compose -f compose.dev.yaml up -d`
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mehmetsahin

# Better Auth. Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The only GitHub account allowed into /admin.
ADMIN_GITHUB_USERNAME=mehmetsahindev

# Where uploaded media is stored (a Docker volume in production).
UPLOADS_DIR=./uploads

# OpenPanel analytics (optional). Leave empty to disable tracking.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
